// Filter direct-child filenames using PowerShell's Filter parameter.
fn list_files(directory: string, pattern: string): string[] {
    if !powershell<bool>("Test-Path", LiteralPath: directory, PathType: "Container") {
        throw Error(message: "Cannot access directory: " + directory)
    }
    return powershell<string[]>(
        "Get-ChildItem", LiteralPath: directory, Filter: pattern, File: true, Name: true
    )
}

// Write UTF-8 without a trailing newline, overwriting any existing file.
fn write_text(path: string, text: string): void {
    powershell<void>(
        "Set-Content", LiteralPath: path, Value: text, Encoding: "utf8", NoNewline: true
    )
}
