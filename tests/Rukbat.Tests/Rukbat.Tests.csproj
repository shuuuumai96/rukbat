<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rukbat\Rukbat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../examples/**/*.rukbat" Link="Fixtures/examples/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/testing/fixtures/*.csv" Link="Fixtures/examples/testing/fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Compile the exact C# 5 helpers for native tests, with a test-only nullable context. -->
  <Target Name="CompileFileLineRuntime" BeforeTargets="CoreCompile">
    <ReadLinesFromFile File="../../src/Rukbat/Runtime/Native/FileText.cs.txt">
      <Output TaskParameter="Lines" ItemName="FileTextRuntimeLines" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="../../src/Rukbat/Runtime/Native/CodePageCodec.cs.txt">
      <Output TaskParameter="Lines" ItemName="CodePageRuntimeLines" />
    </ReadLinesFromFile>
    <WriteLinesToFile File="$(IntermediateOutputPath)FileTextRuntime.cs" Lines="#nullable disable;@(FileTextRuntimeLines)" Overwrite="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)CodePageRuntime.cs" Lines="#nullable disable;@(CodePageRuntimeLines)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)FileTextRuntime.cs" />
      <Compile Include="$(IntermediateOutputPath)CodePageRuntime.cs" />
    </ItemGroup>
  </Target>
</Project>
