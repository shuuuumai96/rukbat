{
  "name": "rukbat",
  "displayName": "Rukbat",
  "description": "Language support for Rukbat Windows system scripts.",
  "version": "0.1.0",
  "publisher": "rukbat",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting is available; the language server starts only in trusted workspaces."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "rukbat",
        "aliases": [
          "Rukbat",
          "rukbat"
        ],
        "extensions": [
          ".rukbat"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rukbat",
        "scopeName": "source.rukbat",
        "path": "./syntaxes/rukbat.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rukbat",
        "path": "./snippets/rukbat.json"
      }
    ],
    "commands": [
      {
        "command": "rukbat.restartServer",
        "title": "Rukbat: Restart Language Server"
      },
      {
        "command": "rukbat.check",
        "title": "Rukbat: Check File"
      },
      {
        "command": "rukbat.test",
        "title": "Rukbat: Test Project"
      },
      {
        "command": "rukbat.build",
        "title": "Rukbat: Build PowerShell"
      },
      {
        "command": "rukbat.run",
        "title": "Rukbat: Run File"
      },
      {
        "command": "rukbat.doctor",
        "title": "Rukbat: Check Environment"
      },
      {
        "command": "rukbat.doc",
        "title": "Rukbat: Generate Documentation"
      }
    ],
    "configuration": {
      "title": "Rukbat",
      "properties": {
        "rukbat.server.command": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional external compiler executable. Empty uses the compiler bundled with this extension."
        },
        "rukbat.server.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Arguments before lsp, such as the absolute path to rukbat.dll when using dotnet."
        }
      }
    },
    "configurationDefaults": {
      "[rukbat]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4
      }
    },
    "problemMatchers": [
      {
        "name": "rukbat",
        "owner": "rukbat-task",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\): error (RUK\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        },
        "severity": "error"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rukbat.run",
          "when": "resourceLangId == rukbat && isWorkspaceTrusted",
          "group": "navigation"
        },
        {
          "command": "rukbat.build",
          "when": "resourceLangId == rukbat && isWorkspaceTrusted",
          "group": "navigation"
        },
        {
          "command": "rukbat.check",
          "when": "resourceLangId == rukbat && isWorkspaceTrusted",
          "group": "navigation"
        },
        {
          "command": "rukbat.test",
          "when": "resourceLangId == rukbat && isWorkspaceTrusted",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:editor": "node test/run-editor.js",
    "package": "node package-extension.js"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "@vscode/test-electron": "3.1.0",
    "vscode-textmate": "9.3.2",
    "vscode-oniguruma": "2.0.1"
  }
}
