{
  "Function": { "prefix": "fn", "body": ["fn ${1:name}(${2}): ${3:void} {", "    $0", "}"] },
  "Test": { "prefix": "test", "description": "Test function; requires import test at module level.", "body": ["fn test_${1:name}(): void {", "    test.assert(${2:condition})", "}"] },
  "Test expected error": {
    "prefix": "test_error",
    "description": "Expected-error test; requires import test at module level.",
    "body": ["fn test_${1:reject_invalid_input}(): void {", "    try {", "        ${2:operation()}", "    } catch err {", "        return", "    }", "", "    test.fail(\"Expected Error was not thrown\")", "}"]
  },
  "For loop": { "prefix": "for", "body": ["for ${1:item} in ${2:items} {", "    $0", "}"] },
  "Try catch": { "prefix": "try", "body": ["try {", "    $1", "} catch ${2:err} {", "    $0", "}"] }
}
