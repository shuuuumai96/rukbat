{
  "Documentation": { "prefix": "doc", "description": "Declaration documentation; write immediately before a declaration.", "body": ["/// ${1:Summary.}", "$0"] },
  "Module documentation": { "prefix": "module_doc", "description": "Module usage documentation; write before the first code statement.", "body": ["//! ${1:Purpose and usage.}", "$0"] },
  "CLI command": {
    "prefix": "cli",
    "description": "Argument definitions, generated help and explicit exit handling; insert at module level.",
    "body": [
      "import cli", "",
      "command := cli.command(\"${1:main.ps1}\", \"${2:Description}\")",
      "command.arguments = [cli.argument(\"${3:input}\", \"${4:Input file}\")]", "",
      "try {",
      "    parsed := cli.parse(command, args())",
      "    if cli.help_requested(parsed) {",
      "        print(cli.help(command))",
      "        exit(0)",
      "    }",
      "    input := cli.get(parsed, \"${3:input}\")",
      "    $0",
      "} catch err {",
      "    eprint(err.message)",
      "    exit(2)",
      "}"
    ]
  },
  "Function": { "prefix": "fn", "body": ["fn ${1:name}(${2}): ${3:void} {", "    $0", "}"] },
  "Constant": { "prefix": "const", "description": "Read-only declaration with type inference.", "body": ["const ${1:name} := ${2:value}"] },
  "Dictionary": { "prefix": "dict", "description": "Typed dictionary with string or int keys.", "body": ["${1:counts}: dict[${2:string}, ${3:int}] = {}", "$0"] },
  "Test": { "prefix": "test", "description": "Test function; requires import test at module level.", "body": ["fn test_${1:name}(): void {", "    test.assert(${2:condition})", "}"] },
  "Test expected error": {
    "prefix": "test_error",
    "description": "Expected-error test; requires import test at module level.",
    "body": ["fn test_${1:reject_invalid_input}(): void {", "    try {", "        ${2:operation()}", "    } catch err {", "        return", "    }", "", "    test.fail(\"Expected Error was not thrown\")", "}"]
  },
  "For loop": { "prefix": "for", "body": ["for ${1:item} in ${2:items} {", "    $0", "}"] },
  "Try catch": { "prefix": "try", "body": ["try {", "    $1", "} catch ${2:err} {", "    $0", "}"] }
}
