{
  "name": "Rukbat",
  "scopeName": "source.rukbat",
  "patterns": [
    { "name": "comment.line.documentation.rukbat", "match": "(?:///(?!/)|//!).*$" },
    { "name": "comment.line.double-slash.rukbat", "match": "//.*$" },
    { "begin": "\"", "end": "\"", "name": "string.quoted.double.rukbat", "patterns": [{ "include": "#escape" }] },
    { "begin": "'", "end": "'", "name": "string.quoted.single.rukbat", "patterns": [{ "include": "#escape" }] },
    { "name": "keyword.control.rukbat", "match": "\\b(import|as|fn|struct|return|if|else|for|in|while|break|continue|try|catch|throw)\\b" },
    { "name": "constant.language.rukbat", "match": "\\b(true|false|null)\\b" },
    { "name": "variable.language.rukbat", "match": "\\bself\\b" },
    { "name": "storage.modifier.rukbat", "match": "\\bconst\\b" },
    { "name": "storage.type.rukbat", "match": "\\b(int|float|string|bool|void|Error)\\b" },
    { "name": "support.function.rukbat", "match": "\\b(print|eprint|args|exit|powershell)\\b" },
    { "name": "constant.numeric.rukbat", "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" },
    { "name": "entity.name.function.rukbat", "match": "[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*(?:<[^>]+>)?\\()" },
    { "name": "keyword.operator.rukbat", "match": ":=|==|!=|<=|>=|&&|\\|\\||[+*/%!=<>?-]" },
    { "name": "punctuation.rukbat", "match": "[{}\\[\\]().,:;]" },
    { "name": "invalid.illegal.rukbat", "match": "#" }
  ],
  "repository": {
    "escape": { "patterns": [
      { "name": "constant.character.escape.rukbat", "match": "\\\\[nrt\\\\'\"]" },
      { "name": "invalid.illegal.escape.rukbat", "match": "\\\\." }
    ] }
  }
}
