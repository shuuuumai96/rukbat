import "./math.rukbat" as arithmetic

struct User {
    name: string
    age: int

    fn is_adult(): bool {
        return self.age >= 20
    }
}

user := User {
    name: "Taro", age: 30
}
result := arithmetic.add(user.age, 2)
print(user.name)
print(result)

if user.is_adult() {
    print("adult")
}

