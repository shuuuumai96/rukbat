import fs
import json
import process

struct Config {
    directory: string
    pattern: string
    executable: string
    arguments: string[]
}

struct CheckResult {
    file: string
    exit_code: int
    stdout: string
    stderr: string
}

fn usage(): string {
    return "Usage: rukbat run examples/batch-check/main.rukbat -- <config.json> <report.json>"
}

arguments: string[] = args()

if arguments.length == 1 && arguments[0] == "--help" {
    print(usage())
    exit(0)
}

try {
    if arguments.length != 2 {
        throw Error {
            message: "Expected exactly two non-empty arguments.\n" + usage()
        }
    }

    if arguments[0] == "" || arguments[1] == "" {
        throw Error {
            message: "Configuration and report paths must be non-empty.\n" + usage()
        }
    }

    configuration_text: string = fs.read_text(arguments[0], "utf-8")
    configuration: Config = json.parse<Config>(configuration_text)

    if configuration.directory == "" || configuration.pattern == "" || configuration.executable == "" {
        throw Error {
            message: "Configuration directory, pattern, and executable must be non-empty."
        }
    }

    matched_files: string[] = fs.list_files_recursive(configuration.directory, configuration.pattern)
    results: CheckResult[] = []
    has_failed_check: bool = false

    for file in matched_files {
        checker_arguments: string[] = configuration.arguments
        checker_arguments.append(file)
        result: process.Result = process.run(configuration.executable, checker_arguments, 30000)
        results.append(CheckResult {
            file: file, exit_code: result.exit_code, stdout: result.stdout, stderr: result.stderr
        })

        if result.exit_code != 0 {
            has_failed_check = true
        }
    }

    report: string = json.stringify(results)
    fs.write_text(arguments[1], report, "utf-8")

    if has_failed_check {
        exit(1)
    }

    exit(0)
} catch err {
    eprint(err.message)
    exit(2)
}

