struct Counter {
    value: int

    fn increment(): void {
        self.value = self.value + 1
    }
}

struct Box {
    counter: Counter
}

a: Box = Box {
    counter: Counter {
        value: 30
    }
}
b: Box = a
b.counter.increment()
print(a.counter.value)  // 30: The original remains unchanged
print(b.counter.value)  // 31: Only the variable receiving the method call is updated
