struct User {
    name: string
    age: int

    fn birthday(): void {
        self.age = self.age + 1
    }
}

users: User[] = powershell<User[]>("ConvertFrom-Json", '[{"name":"Taro","age":30},{"name":"Hanako","age":25}]')
users[0].birthday()

for user in users {
    print(user.name)
    print(user.age)
}
