import encoding
import fs
import text

arguments := args()

if arguments.length != 2 {
    eprint("Usage: filter-errors.ps1 <input.log> <output.log>")
    exit(2)
}

try {
    for writer in fs.stage_text(arguments[1], encoding.utf8) {
        first := true

        for line in fs.lines(arguments[0], encoding.utf8) {
            cleaned := text.trim(line)

            if !text.starts_with(cleaned, "ERROR:") {
                continue
            }

            if !first {
                fs.write_chunk(writer, "\r\n")
            }

            fs.write_chunk(writer, cleaned)
            first = false
        }

        fs.commit(writer)
    }
} catch err {
    eprint(err.message)
    exit(1)
}
