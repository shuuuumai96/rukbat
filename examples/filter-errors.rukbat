import fs
import text

arguments := args()

if arguments.length != 2 {
    eprint("Usage: filter-errors.ps1 <input.log> <output.log>")
    exit(2)
}

try {
    content := fs.read_text(arguments[0], "utf-8")
    lines := text.split_lines(content)
    errors: string[] = []

    for line in lines {
        cleaned := text.trim(line)

        if text.starts_with(cleaned, "ERROR:") {
            errors.append(cleaned)
        }
    }

    report := text.join(errors, "\r\n")
    fs.write_text(arguments[1], report, "utf-8")
} catch err {
    eprint(err.message)
    exit(1)
}
