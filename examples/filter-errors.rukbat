import encoding
import fs
import text

arguments := args()

if arguments.length != 2 {
    eprint("Usage: filter-errors.ps1 <input.log> <output.log>")
    exit(2)
}

try {
    errors: string[] = []

    for line in fs.lines(arguments[0], encoding.utf8) {
        cleaned := text.trim(line)

        if text.starts_with(cleaned, "ERROR:") {
            errors.append(cleaned)
        }
    }

    report := text.join(errors, "\r\n")
    fs.write_text(arguments[1], report, encoding.utf8)
} catch err {
    eprint(err.message)
    exit(1)
}
