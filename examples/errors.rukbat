fn require_directory(directory: string): void {
    if directory == "" {
        throw Error {
            message: "Please specify a directory"
        }
    }
}

try {
    require_directory("")
} catch err {
    print(err.message)
}

try {
    powershell<void>("Write-Error", "PowerShell operation failed")
} catch err {
    print(err.message)
}

try {
    try {
        throw Error {
            message: "Rethrown error"
        }
    } catch err {
        throw err
    }
} catch err {
    print(err.message)
}

print("Execution continues after error handling")

