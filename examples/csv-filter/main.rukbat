import csv
import encoding
import fs
import text

fn parse_bool_cell(row: csv.Row, column: string, record_number: int): bool {
    try {
        return text.parse_bool(csv.get(row, column))
    } catch err {
        err.message = "CSV record " + text.from_int(record_number) + ", column " + column + ": " + err.message
        throw err
    }
}

fn main(): void {
    arguments := args()

    if arguments.length != 3 {
        throw Error {
            message: "Usage: csv-filter INPUT.csv OUTPUT.csv INPUT_ENCODING"
        }
    }

    people := csv.parse_table(fs.read_text(arguments[0], encoding.parse(arguments[2])))

    if !csv.has_column(people, "enabled") || !csv.has_column(people, "note") {
        throw Error {
            message: "CSV requires enabled and note columns."
        }
    }

    kept: csv.Row[] = []
    record_number := 1

    for person in people.rows {
        record_number = record_number + 1

        if parse_bool_cell(person, "enabled", record_number) {
            kept.append(csv.set(person, "note", "checked"))
        }
    }

    people.rows = kept
    fs.write_text(arguments[1], csv.stringify_table(people), encoding.utf8)
}

try {
    main()
} catch err {
    eprint(err.message)
    const invalid_input_or_operation := 2
    exit(invalid_input_or_operation)
}
