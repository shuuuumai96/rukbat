import "./services/file-listing.auv" as listing
import "./options.auv" as options
import "../../lib/files.auv" as files
import "../../lib/json.auv" as json

settings: options.Options = options.parse(args())
if settings.help {
    print(options.usage())
} else {
    items: string[] = listing.matching_files(settings.directory, settings.pattern)
    output: string = json.encode_strings(items)
    if settings.output == "" {
        print(output)
    } else {
        files.write_text(settings.output, output)
    }
}
