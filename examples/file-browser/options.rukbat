import cli

struct Options {
    directory: string
    pattern: string
    output: string
    help: bool
}

fn definition(): cli.Command {
    name := ".\\main.ps1"
    description := "List matching files as JSON."
    command := cli.command(name, description)
    command.arguments = [cli.argument("directory", "Directory to search")]
    pattern := cli.option("pattern", "Filename pattern")
    pattern.default_value = "*"
    output := cli.option("output", "Output file; omitted means stdout")
    output.short_name = "o"
    output.value_name = "FILE"
    command.options = [pattern, output]
    return command
}

fn usage(): string {
    deployed := cli.help(definition())
    development := "\n\nRukbat (from repository root):\n  .\\rukbat.cmd run examples/file-browser/main.rukbat -- [options] DIRECTORY"
    deployment := "\n\nGenerated PowerShell: run the Usage above from the directory containing main.ps1."
    editor := "\n\nVS Code: Rukbat: Run File\n  Enter program arguments as a JSON array:\n  [\"C:/Windows\", \"--pattern\", \"*.exe\"]\n  Help: [\"--help\"]"
    return deployed + development + deployment + editor
}

fn parse(arguments: string[]): Options {
    parsed := cli.parse(definition(), arguments)

    if cli.help_requested(parsed) {
        return Options {
            directory: "", pattern: "*", output: "", help: true
        }
    }

    output := ""

    if cli.has(parsed, "output") {
        output = cli.get(parsed, "output")
    }

    return Options {
        directory: cli.get(parsed, "directory"), pattern: cli.get(parsed, "pattern"), output: output, help: false
    }
}
