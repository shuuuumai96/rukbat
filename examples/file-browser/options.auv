struct Options {
    directory: string
    pattern: string
    output: string
    help: bool
}

fn usage(): string {
    return "Usage: auvil run examples/file-browser/main.auv -- <directory> [--pattern <glob>] [--output <file>]\nヘルプ: auvil run examples/file-browser/main.auv -- --help"
}

fn parse(arguments: string[]): Options {
    if arguments.length == 0 {
        throw Error(message: usage())
    }
    options: Options = Options(directory: arguments[0], pattern: "*", output: "", help: false)
    if arguments.length == 1 && arguments[0] == "--help" {
        options.help = true
        return options
    }
    if options.directory == "" {
        throw Error(message: "ディレクトリを指定してください")
    }

    first: bool = true
    pending: string = ""
    pattern_seen: bool = false
    output_seen: bool = false
    for argument in arguments {
        if first {
            first = false
            continue
        }
        if pending == "--pattern" {
            if argument == "" {
                throw Error(message: "--pattern には空でないパターンを指定してください")
            }
            options.pattern = argument
            pending = ""
            continue
        }
        if pending == "--output" {
            if argument == "" {
                throw Error(message: "--output には空でない保存先を指定してください")
            }
            options.output = argument
            pending = ""
            continue
        }
        if argument == "--pattern" {
            if pattern_seen {
                throw Error(message: "--pattern は一度だけ指定してください")
            }
            pattern_seen = true
            pending = argument
        } else {
            if argument == "--output" {
                if output_seen {
                    throw Error(message: "--output は一度だけ指定してください")
                }
                output_seen = true
                pending = argument
            } else {
                throw Error(message: "不明なオプションまたは余分な引数: " + argument + "\n" + usage())
            }
        }
    }
    if pending != "" {
        throw Error(message: pending + " の値を指定してください")
    }
    return options
}
