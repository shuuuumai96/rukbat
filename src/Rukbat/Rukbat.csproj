<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rukbat</AssemblyName>
    <RootNamespace>Rukbat</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management.Automation" Version="7.4.19" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Runtime/*.cs.txt" WithCulture="false" LogicalName="Rukbat.Runtime.%(Filename)%(Extension)" />
    <Compile Include="Runtime/ProcessJob.cs.txt" Link="Runtime/ProcessJob.cs" />
  </ItemGroup>

</Project>
