<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rukbat</AssemblyName>
    <RootNamespace>Rukbat</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../docs/THIRD_PARTY_NOTICES.txt" Link="THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../docs/STDLIB.md" LogicalName="Rukbat.StandardLibrary.md" />
    <PackageReference Include="System.Management.Automation" Version="7.4.19" />
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Runtime/*.cs.txt" WithCulture="false" LogicalName="Rukbat.Runtime.%(Filename)%(Extension)" />
    <Compile Include="Runtime/ProcessJob.cs.txt" Link="Runtime/ProcessJob.cs" />
  </ItemGroup>

</Project>
